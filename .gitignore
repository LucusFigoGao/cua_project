# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.vscode/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# ── Node / Vite（CUA-Gym-Hub mock 应用）──────────────────────────────────
node_modules/

# ── 环境变量（含 API 密钥，切勿提交）─────────────────────────────────────
.env
.env.local
.env.*.local
# 例外：该文件仅为监视器配置，仓库有意跟踪（文件内注明不含敏感信息）
!osworld/monitor/.env

# ── CUA-Gym-Hub 运行期状态（mock 运行时自动生成的产物）───────────────────
.mock-states/
.mock-files/
.mock-state.json
.mock-state.initial.json

gym/hub/.playwright-mcp

# ── CUA-Gym / OSWorld 运行期输出 ─────────────────────────────────────────
gym/output/
osworld/results*/
*.log
gym/cache/

configs/

# workspace 下的配置区分对待：apps.json 是 31 个 app→固定端口的唯一事实来源，
# sandbox/deploy.py 和 tasks/urlmap.py 运行时都要读它，必须进版本库；
# sandbox_pool.json 是运行期状态（实例 id），不进。
!workspace/configs/
workspace/configs/*
!workspace/configs/apps.json

workspace/smoke_test
!workspace/smoke_test/
workspace/tasks_data/*

.cache